{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "includeFiles": "{templates/**,public/static/**,ml/**}"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "public/static/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "public/static/favicon.svg"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
